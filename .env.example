# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MERCADO_PAGO_ACCESS_TOKEN: Access Token for Mercado Pago integration (Checkout Pro, Pix, Cartão)
MERCADO_PAGO_ACCESS_TOKEN="APP_USR-3601228991521911-102618-e2449d1648cbac170dda941d0757cc4c-3635249681"

# MERCADO_PAGO_PUBLIC_KEY: Public key for Mercado Pago integration
MERCADO_PAGO_PUBLIC_KEY="APP_USR-8fe5ef83-c0f5-4412-950c-64ad3f6283dd"

# Chaves solicitadas (Alias)
KEY_PUBLIC-MERCADO_PAGO="APP_USR-8fe5ef83-c0f5-4412-950c-64ad3f6283dd"
ACESS-TOK_MERCADO_PAGO="APP_USR-3601228991521911-102618-e2449d1648cbac170dda941d0757cc4c-3635249681"
